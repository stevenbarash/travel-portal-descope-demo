{
  "flow": {
    "id": "pd-profile",
    "name": "PD - Progressive profile",
    "description": "Reusable subflow: collects the customer name only if missing; uses booking details passed in as form.displayName so customers never re-enter them.",
    "dsl": {
      "startTask": "1",
      "tasks": {
        "1": {
          "conditions": [
            {
              "atomicConditions": [
                {
                  "operator": "not-empty",
                  "predicate": {
                    "type": "inline",
                    "value": ""
                  },
                  "target": {
                    "type": "context",
                    "value": "user.name"
                  }
                }
              ],
              "interactionId": "has",
              "name": "Yes"
            },
            {
              "interactionId": "ELSE",
              "name": "Otherwise"
            }
          ],
          "id": "1",
          "name": "Name already on account?",
          "next": {
            "rules": [
              {
                "interactionId": "has",
                "taskId": "99"
              },
              {
                "interactionId": "ELSE",
                "taskId": "2"
              }
            ]
          },
          "type": "condition",
          "view": {
            "x": 276,
            "y": 12
          }
        },
        "2": {
          "conditions": [
            {
              "atomicConditions": [
                {
                  "operator": "not-empty",
                  "predicate": {
                    "type": "inline",
                    "value": ""
                  },
                  "target": {
                    "type": "context",
                    "value": "form.displayName"
                  }
                }
              ],
              "interactionId": "booking",
              "name": "Yes"
            },
            {
              "interactionId": "ELSE",
              "name": "Otherwise"
            }
          ],
          "id": "2",
          "name": "Name passed in from booking?",
          "next": {
            "rules": [
              {
                "interactionId": "booking",
                "taskId": "4"
              },
              {
                "interactionId": "ELSE",
                "taskId": "3"
              }
            ]
          },
          "type": "condition",
          "view": {
            "x": 756,
            "y": 96
          }
        },
        "3": {
          "allInputKeys": ["displayName"],
          "id": "3",
          "inputKeys": ["displayName"],
          "name": "Ask for name",
          "next": {
            "rules": [
              {
                "interactionId": "save",
                "taskId": "4"
              }
            ]
          },
          "screenId": "pr-name",
          "type": "screen",
          "view": {
            "x": 1236,
            "y": 144
          }
        },
        "4": {
          "action": "update-user-properties",
          "arguments": {
            "userPropertiesDefinitions": {
              "type": "inline",
              "value": [
                {
                  "key": "displayName",
                  "type": "context",
                  "value": "form.displayName"
                }
              ]
            }
          },
          "id": "4",
          "name": "Save name",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "99"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 1728,
            "y": 168
          }
        },
        "99": {
          "action": "logged-in",
          "id": "99",
          "name": "End",
          "next": {},
          "type": "automated",
          "view": {
            "x": 2208,
            "y": 60
          }
        },
        "start": {
          "id": "start",
          "name": "start",
          "next": {
            "rules": [
              {
                "taskId": "1"
              }
            ]
          },
          "view": {
            "x": 12,
            "y": 12
          }
        }
      }
    },
    "disabled": false
  },
