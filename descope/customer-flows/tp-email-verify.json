{
  "flow": {
    "id": "tp-email-verify",
    "name": "TP - Email verification (code or link)",
    "description": "Reusable subflow: email OTP with masked address and resend; optional magic link alternative.",
    "dsl": {
      "startTask": "1",
      "tasks": {
        "1": {
          "action": "sign-up-or-in-otp-email",
          "id": "1",
          "name": "Send email code",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "2"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 0,
            "y": 0
          }
        },
        "2": {
          "allInputKeys": ["code"],
          "calculatedInputKeys": true,
          "contextKeys": ["sentTo.maskedEmail"],
          "id": "2",
          "inputKeys": ["code"],
          "name": "Enter code",
          "next": {
            "rules": [
              {
                "interactionId": "code",
                "taskId": "3"
              },
              {
                "interactionId": "resend",
                "taskId": "1"
              },
              {
                "interactionId": "use-link",
                "taskId": "4"
              }
            ]
          },
          "screenId": "ev-code",
          "type": "screen",
          "view": {
            "x": 300,
            "y": 0
          }
        },
        "3": {
          "action": "verify-code-otp-email",
          "id": "3",
          "name": "Verify email code",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "99"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 600,
            "y": 0
          }
        },
        "4": {
          "action": "sign-up-or-in-magic-linkv3-email",
          "arguments": {
            "verifyStepId": {
              "type": "inline",
              "value": "4.end"
            }
          },
          "id": "4",
          "name": "Send magic link",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "5"
              },
              {
                "interactionId": "success",
                "taskId": "4.end"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 900,
            "y": 0
          }
        },
        "5": {
          "contextKeys": ["sentTo.maskedEmail"],
          "id": "5",
          "name": "Check your inbox",
          "next": {
            "rules": [
              {
                "interactionId": "polling",
                "taskId": "6"
              },
              {
                "interactionId": "resend",
                "taskId": "4"
              },
              {
                "interactionId": "use-code",
                "taskId": "1"
              }
            ]
          },
          "screenId": "ev-link",
          "type": "screen",
          "view": {
            "x": 1500,
            "y": 0
          }
        },
        "6": {
          "id": "6",
          "name": "Link opened",
          "next": {},
          "screenId": "ev-done",
          "type": "screen",
          "view": {
            "x": 1800,
            "y": 0
          }
        },
        "99": {
          "action": "logged-in",
          "id": "99",
          "name": "End",
          "next": {},
          "type": "automated",
          "view": {
            "x": 2100,
            "y": 0
          }
        },
        "4.end": {
          "action": "verify-magic-link",
          "id": "4.end",
          "name": "Verify magic link",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "99"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 1200,
            "y": 0
          }
        },
        "start": {
          "id": "start",
          "name": "start",
          "next": {
            "rules": [
              {
                "taskId": "1"
              }
            ]
          },
          "view": {
            "x": 2480,
            "y": 0
          }
        }
      }
    },
    "disabled": false
  },
