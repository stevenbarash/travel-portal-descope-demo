{
  "flow": {
    "id": "tp-mfa",
    "name": "TP - Authenticator app MFA (optional)",
    "description": "Reusable subflow: challenges customers who enrolled an authenticator app; offers optional TOTP setup (any authenticator app) to new customers.",
    "dsl": {
      "startTask": "1",
      "tasks": {
        "1": {
          "conditions": [
            {
              "atomicConditions": [
                {
                  "operator": "is-true",
                  "predicate": {
                    "type": "inline",
                    "value": ""
                  },
                  "target": {
                    "type": "context",
                    "value": "user.totp"
                  }
                }
              ],
              "interactionId": "has",
              "name": "Yes"
            },
            {
              "atomicConditions": [
                {
                  "operator": "is-true",
                  "predicate": {
                    "type": "inline",
                    "value": ""
                  },
                  "target": {
                    "type": "context",
                    "value": "authInfo.firstSeen"
                  }
                }
              ],
              "interactionId": "new",
              "name": "No - new customer"
            },
            {
              "interactionId": "ELSE",
              "name": "Otherwise"
            }
          ],
          "id": "1",
          "name": "Has authenticator app?",
          "next": {
            "rules": [
              {
                "interactionId": "has",
                "taskId": "2"
              },
              {
                "interactionId": "new",
                "taskId": "4"
              },
              {
                "interactionId": "ELSE",
                "taskId": "99"
              }
            ]
          },
          "type": "condition",
          "view": {
            "x": 0,
            "y": 0
          }
        },
        "2": {
          "allInputKeys": ["code"],
          "calculatedInputKeys": true,
          "id": "2",
          "inputKeys": ["code"],
          "name": "Enter authenticator code",
          "next": {
            "rules": [
              {
                "interactionId": "code",
                "taskId": "3"
              }
            ]
          },
          "screenId": "mfa-verify",
          "type": "screen",
          "view": {
            "x": 300,
            "y": 0
          }
        },
        "3": {
          "action": "verify-totp-code",
          "id": "3",
          "name": "Verify TOTP",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "99"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 600,
            "y": 0
          }
        },
        "4": {
          "id": "4",
          "name": "Offer authenticator app",
          "next": {
            "rules": [
              {
                "interactionId": "setup",
                "taskId": "5"
              },
              {
                "interactionId": "skip",
                "taskId": "99"
              }
            ]
          },
          "screenId": "mfa-offer",
          "type": "screen",
          "view": {
            "x": 900,
            "y": 0
          }
        },
        "5": {
          "action": "update-user-totp",
          "id": "5",
          "name": "Create TOTP",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "6"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 1200,
            "y": 0
          }
        },
        "6": {
          "allInputKeys": ["code"],
          "calculatedInputKeys": true,
          "id": "6",
          "inputKeys": ["code"],
          "name": "Scan QR code",
          "next": {
            "rules": [
              {
                "interactionId": "code",
                "taskId": "7"
              }
            ]
          },
          "screenId": "mfa-setup",
          "type": "screen",
          "view": {
            "x": 1500,
            "y": 0
          }
        },
        "7": {
          "action": "verify-totp-code",
          "id": "7",
          "name": "Verify TOTP",
          "next": {
            "rules": [
              {
                "interactionId": "success",
                "taskId": "99"
              }
            ]
          },
          "type": "automated",
          "view": {
            "x": 1800,
            "y": 0
          }
        },
        "99": {
          "action": "logged-in",
          "id": "99",
          "name": "End",
          "next": {},
          "type": "automated",
          "view": {
            "x": 2100,
            "y": 0
          }
        },
        "start": {
          "id": "start",
          "name": "start",
          "next": {
            "rules": [
              {
                "taskId": "1"
              }
            ]
          },
          "view": {
            "x": 2480,
            "y": 0
          }
        }
      }
    },
    "disabled": false
  },
