# Copy to .env at the repo root. Both apps read this one file.

# --- Descope (required) ---
DESCOPE_PROJECT_ID=
VITE_DESCOPE_PROJECT_ID=

# Management key: required for seed/reset/snapshot scripts and admin routes. Never commit.
DESCOPE_MANAGEMENT_KEY=

# Custom domain (CNAME) if configured, e.g. https://auth.example.com. Leave empty for default.
DESCOPE_BASE_URL=
VITE_DESCOPE_BASE_URL=

# --- Demo personas ---
# Your work email. `npm run seed` creates one real user per persona at you+<persona>@<domain>
# (e.g. you+guest@yourcompany.com) to sign in as when presenting; codes arrive in your inbox.
# E2E keeps using the @example.com test users. `npm run users` prints who to sign in as.
DEMO_EMAIL=

# --- Demo switches (flip mid-demo; the debug drawer shows current values) ---
# Descope User Profile widget on /me (My account): name, email, phone, passkeys, password, MFA.
VITE_DESCOPE_USER_PROFILE_WIDGET_ID=user-profile-widget
# TravelCorp's sign-up-or-in flow: import descope/customer-flows/ into the project first (see README).
VITE_DESCOPE_FLOW_ID=tp-sign-up-or-in
VITE_DESCOPE_STEP_UP_FLOW_ID=demo-step-up
# Optional: Descope style IDs (console → Styles) for hosted flows and embedded widgets. Empty uses
# brand.descopeStyleId / brand.descopeWidgetStyleId; set these when the project has its own styles.
# A style ID the project doesn't have renders the flow unstyled. The kit never edits project styles.
VITE_DESCOPE_STYLE_ID=
VITE_DESCOPE_WIDGET_STYLE_ID=
# true = session token in a cookie (DS); false = in memory, sent as Authorization: Bearer
VITE_SESSION_VIA_COOKIE=false

# --- Server ---
PORT=3001
# Origins allowed to call the API directly (comma-separated; not needed behind the Vite proxy).
WEB_ORIGIN=http://localhost:5173

# Optional server-only test code, matching Console → Project Settings → Test Users → Static OTP
# (also set its verifier regex to cover the seeded test users). Never use a VITE_ prefix. It is
# not migrated with project import/export. Blank = management-generated codes.
DESCOPE_TEST_OTP=

# Optional: shared secret for /api/connectors/* (a Descope HTTP connector sends it as the
# x-connector-secret header). 16+ random chars, e.g. `openssl rand -hex 24`. Blank = routes off (503).
# `npm run tunnel` exposes only /api/connectors/* publicly. apps/api/src/features/connectors/README.md
CONNECTOR_SECRET=
# POST /api/demo/reset restores in-memory demo data (e2e calls it). On unless NODE_ENV=production.
# KIT_DEMO_RESET=false
